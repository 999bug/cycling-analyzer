<view class="imp">
  <view class="imp-hero">
    <text class="imp-title">导入 FIT 文件</text>
    <text class="imp-sub">离线解析 · 不联网 · 数据只存在你手机上</text>
  </view>

  <view class="imp-card">
    <text class="imp-step">操作步骤</text>
    <view class="step"><text class="num">1</text><text class="txt">把 .fit 文件发到微信「文件传输助手」（或任意会话）</text></view>
    <view class="step"><text class="num">2</text><text class="txt">点击下方按钮，从聊天里选择该文件</text></view>
    <view class="step"><text class="num">3</text><text class="txt">自动解析并存入「我的本地数据」，可在活动页查看</text></view>
  </view>

  <button class="imp-btn" bindtap="onChoose" loading="{{status === 'parsing'}}">
    {{status === 'parsing' ? '解析中…' : '选择 .fit 文件'}}
  </button>

  <view wx:if="{{status === 'done'}}" class="imp-msg ok">{{msg}}</view>
  <view wx:if="{{status === 'error'}}" class="imp-msg err">{{msg}}</view>

  <view class="imp-count">已导入活动：{{count}} 条</view>

  <view class="imp-tip">提示：切换「我的本地数据」与「作者公开数据」可在「我的」页完成。</view>
</view>
