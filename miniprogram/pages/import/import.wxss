.imp {
  padding: 32rpx 28rpx 60rpx;
}
.imp-hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}
.imp-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2933;
}
.imp-sub {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 8rpx;
}
.imp-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 28rpx;
}
.imp-step {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
}
.step {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}
.num {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #2f6df6;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 36rpx;
  margin-right: 16rpx;
}
.txt {
  font-size: 26rpx;
  color: #5b6472;
  line-height: 38rpx;
}
.imp-btn {
  background: #2f6df6;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}
.imp-msg {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.imp-msg.ok {
  background: #e8f6ec;
  color: #1a9e4b;
}
.imp-msg.err {
  background: #fdecea;
  color: #e2574c;
}
.imp-count {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2933;
  font-weight: 600;
}
.imp-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  text-align: center;
  line-height: 34rpx;
}
